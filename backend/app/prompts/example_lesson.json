            "count": 120,
            "emit": [
              3.5,
              9.5
            ],
            "x": [
              430,
              610
            ],
            "y": [
              140,
              150
            ],
            "vx": [
              -4,
              4
            ],
            "vy": [
              90,
              130
            ],
            "gravity": 60,
            "floor": 336,
