    {
      "kind": "simulation",
      "id": "dry",
      "title": "Dry the puddle",
      "tag": "Try it · sliders",
      "intro": "A puddle sits on the pavement. You control the weather. Predict first, then test it.",
      "caption": "Your turn: predict, then test it with the sliders.",
      "controls": [
        {
          "id": "T",
          "label": "Air temperature",
          "min": 0,
          "max": 40,
          "step": 1,
          "initial": 10,
          "unit": " °C"
        },
        {
          "id": "W",
          "label": "Wind",
          "min": 0,
          "max": 100,
          "step": 5,
          "initial": 0,
          "unit": "%"
        }
      ],
      "state": {
        "water": 1,
        "vap": 0
      },
      "update": [
        {
          "var": "water",
          "expr": "max(0, water - rate(T, W) * dt * 0.12)"
        },
        {
          "var": "vap",
          "expr": "1 - water"
        }
      ],
      "predict": {
        "question": "Which day dries a puddle fastest?",
        "options": [
          {
            "label": "Cold and still",
            "correct": false,
            "feedback": "Cold water molecules move slowly, so few escape. Try it and see."
          },
          {
            "label": "Warm and windy",
            "correct": true,
            "feedback": "Right. Heat speeds the molecules up and wind carries the vapor away. Confirm it with the sliders."
          },
          {
            "label": "Warm and still",
            "correct": false,
            "feedback": "Close. Warmth helps, but still air fills up with vapor. Add wind and compare."
          }
        ]
      },
      "readouts": [
        {
          "label": "Evaporation rate",
          "kind": "bar",
          "value": "rate(T, W)"
        },
        {
          "label": "Puddle left",
          "kind": "text",
          "value": "round(water * 100) + '%'"
        },
        {
          "label": "Status",
          "kind": "text",
          "rules": [
            {
              "when": "water <= 0.02",
              "text": "Dry"
            },
            {
              "when": "rate(T, W) < 0.25",
              "text": "Drying slowly"
            },
            {
              "when": "true",
              "text": "Drying fast"
            }
          ]
        }
      ],
      "presets": [
        {
          "label": "Heat wave 38 °C",
          "set": {
            "T": 38
          }
        },
        {
          "label": "Gale",
          "set": {
            "W": 100
          }
        },
        {
          "label": "Freezing 0 °C",
          "set": {
            "T": 0
          }
        },
        {
          "label": "Refill puddle",
          "reset": true
        }
      ],
      "goal": {
        "when": "water <= 0.02",
        "note": "The puddle evaporated. Continue when you are ready."
      },
      "scene": {
        "elements": [
          {
            "type": "rect",
            "x": 0,
            "y": 330,
            "w": 800,
            "h": 120,
            "fill": "#3A3A2E"
          },
          {
            "type": "ellipse",
            "x": 400,
            "y": 362,
            "rx": {
              "$": "20 + 200 * water"
            },
            "ry": {
              "$": "5 + 20 * water"
            },
            "fill": "@sea",
            "alpha": {
              "$": "water > 0.01 ? 1 : 0"
            }
          },
          {
            "type": "scatter",
            "seed": 4,
            "count": 140,
            "x": 150,
            "y": 60,
            "w": 500,
            "h": 230,
            "r": [
              1.5,
              3
            ],
            "color": "@vapor",
            "fraction": {
              "$": "vap"
            }
          },
          {
            "type": "group",
            "repeat": 4,
            "alpha": {
              "$": "W / 100"
            },
            "y": {
              "$": "i * 40"
            },
            "children": [
              {
                "type": "path",
                "d": "M40 120 C80 110 120 130 160 120",
                "stroke": "#CFE3D6",
                "lineWidth": 2
              }
            ]
          },
          {
            "type": "label",
            "text": {
              "$": "T + ' °C · wind ' + W + '%'"
            },
            "x": 400,
            "y": 428,
            "bg": true
          }
        ]
      }
    },
