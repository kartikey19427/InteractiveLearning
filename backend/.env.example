# Copy to backend/.env and fill in.
DATABASE_URL=postgresql+asyncpg://learning:learning@localhost:5432/learning
# Private maintenance key for DELETE endpoints. Leave empty to disable deletion.
ADMIN_API_KEY=
# Optional mounted files override the corresponding keys. Updated values are
# loaded on the next use after this cache expires. DATABASE_URL stays static.
SECRET_REFRESH_SECONDS=60
# GEMINI_API_KEY_FILE=/etc/api-secrets/gemini/key
# ELEVENLABS_API_KEY_FILE=/etc/api-secrets/elevenlabs/key
# TAVILY_API_KEY_FILE=/etc/api-secrets/tavily/key
# ADMIN_API_KEY_FILE=/etc/api-secrets/admin/key

# gemini (default) or anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Recorded narration voice
TTS_MODEL=gemini-3.8-flash-tts
TTS_VOICE=Charon
# Recorded narration with ElevenLabs instead (used whenever this key is set)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Gfpl8Yo74Is0W6cPUWWT
ELEVENLABS_MODEL=eleven_multilingual_v2

# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Web search for research, free key at https://tavily.com
TAVILY_API_KEY=
