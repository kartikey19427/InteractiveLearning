            }
          }
        ]
      }
    },
    {
      "kind": "quiz",
      "id": "quiz",
      "title": "Check understanding",
      "tag": "Quiz · 3 questions",
      "questions": [
        {
          "question": "What makes a puddle evaporate faster?",
          "options": [
            "Cold, still air",
            "Warm, moving air",
            "Darkness"
          ],
          "answer": 1,
          "explanation": "Heat speeds up molecules so more escape, and wind carries the vapor away."
        },
        {
          "question": "What does water vapor need to condense into a cloud droplet?",
          "options": [
            "A tiny particle such as dust",
            "Sunlight",
            "Salt water"
          ],
          "answer": 0,
          "explanation": "Vapor condenses onto tiny particles called condensation nuclei."
        },
        {
          "question": "Why do cloud droplets eventually fall?",
          "options": [
            "The cloud runs out of air",
            "They merge until rising air can't hold them up",
            "Wind pushes them down"
          ],
          "answer": 1,
          "explanation": "Collisions grow droplets until gravity wins over the rising air."
        }
      ],
      "scene": {
        "elements": [
          {
            "type": "cycle",
            "x": 400,
            "y": 225,
            "rx": 250,
            "ry": 150,
            "nodes": [
              {
                "label": "Evaporation",
                "step": "evaporate"
              },
              {
